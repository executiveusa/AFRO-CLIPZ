# ============================================================================
# AFRO-CLIPZ Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git
# ============================================================================

# ----------------------------------------------------------------------------
# Core Infrastructure
# ----------------------------------------------------------------------------
PORT=8080
PYTHON_VERSION=3.12
PYTHONUNBUFFERED=1

# ----------------------------------------------------------------------------
# Video Processing Configuration
# ----------------------------------------------------------------------------
# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# Video file paths
VIDEO_INPUT_PATH=input_video.mp4
VIDEO_OUTPUT_PATH=edited_output.mp4

# User query for video clipping
USER_QUERY="Find all clips where there is discussion around GPT-4 Turbo"

# ----------------------------------------------------------------------------
# API Integration (Optional)
# ----------------------------------------------------------------------------
# Groq API for AI-powered segment selection
# Get your key from: https://console.groq.com/keys
# Leave as 'stub-key' to use stub mode (no real API calls)
GROQ_API_KEY=stub-key

# API endpoint (usually don't need to change this)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ----------------------------------------------------------------------------
# Cost Protection & Monitoring
# ----------------------------------------------------------------------------
# Enable resource usage monitoring
ENABLE_COST_MONITORING=true

# Memory limit in MB before triggering maintenance mode
FREE_TIER_LIMIT_MB=500

# Automatically shutdown when limit exceeded
AUTO_SHUTDOWN_ON_LIMIT=true

# Maintenance mode (set to true to activate maintenance page)
MAINTENANCE_MODE_ENABLED=false

# ----------------------------------------------------------------------------
# Deployment Configuration
# ----------------------------------------------------------------------------
# Target platform: railway, coolify, docker
DEPLOYMENT_TARGET=railway

# Deployment mode: zero-secrets, production
DEPLOYMENT_MODE=zero-secrets

# Debug mode (more verbose logging)
DEBUG=false

# ----------------------------------------------------------------------------
# VPN Configuration (Optional - for Hostinger VPN deployment)
# ----------------------------------------------------------------------------
VPN_ENABLED=false
VPN_INTERFACE=tun0
VPN_PROVIDER=hostinger

# ----------------------------------------------------------------------------
# Auth (JWT + Google OAuth)
# ----------------------------------------------------------------------------
SESSION_SECRET=your-random-secret-here-run-python-secrets-token_hex-32
TOKEN_EXPIRE_HOURS=72

# Google OAuth — get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# SQLite (default, zero-config — leave blank to use local file)
DB_PATH=

# Supabase (optional upgrade — fill both to use Supabase instead)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Billing — Lemon Squeezy
# ----------------------------------------------------------------------------
# Get from https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Variant IDs for each plan/term combo — found in your LS dashboard
LS_VARIANT_CREATOR_PRO_ANNUAL=
LS_VARIANT_CREATOR_PRO_2YEAR=
LS_VARIANT_STUDIO_ANNUAL=
LS_VARIANT_STUDIO_2YEAR=
LS_VARIANT_BLACK_LABEL_ANNUAL=
LS_VARIANT_BLACK_LABEL_2YEAR=

# Public app URL for billing redirects
APP_URL=https://afromations.app

# ----------------------------------------------------------------------------
# Observability (optional)
# ----------------------------------------------------------------------------
SENTRY_DSN=

# CORS — comma-separated origins, or * for development
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# File Storage
# ----------------------------------------------------------------------------
UPLOAD_DIR=/tmp/afromations/uploads
OUTPUT_DIR=/tmp/afromations/outputs

# ----------------------------------------------------------------------------
# Advanced Settings (Usually don't need to change)
# ----------------------------------------------------------------------------
# FFmpeg settings
FFMPEG_LOGLEVEL=error

# MoviePy settings
IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg

# Whisper cache directory
WHISPER_CACHE_DIR=~/.cache/whisper
